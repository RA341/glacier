{
	"name": "ui",
	"description": "Frontend for the glacier project",
	"author": "ra341",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"devfrost": "vite --mode frostdev --port 5122",
		"build": "vite build",
		"buildfrost": "vite build --mode frost",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"desk:dev": "cross-env NODE_ENV=development electron .",
		"desk:build": "npx electron-builder --dir"
	},
	"main": "electron.cjs",
	"build": {
		"appId": "dev.radn.glacier",
		"files": [
			"electron.cjs"
		],
		"directories": {
			"output": "release"
		},
		"win": {
			"icon": "static/favicon.png"
		},
		"linux": {
			"icon": "static/favicon.png"
		}
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.16.0",
		"@connectrpc/connect": "^2.2.0",
		"@connectrpc/connect-web": "^2.2.0",
		"@lucide/svelte": "^0.562.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"cross-env": "^10.1.0",
		"electron": "^39.8.10",
		"electron-builder": "^26.15.3",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
